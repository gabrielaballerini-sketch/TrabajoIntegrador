extends ../layoutPublico.pug
include ../mixins/alert

block metadata
  title Registrarse

block formulario
  
        .card.shadow(style='width: 22rem;')
          .card-body

            h3.card-title.text-center.mb-4 Registrarse
            
            +alert(alert)
           
          
              



            form(method='POST', action='/auth/signup')

              .mb-3
                label.form-label(for='nombre') Nombre
                input.form-control(
                  type='text',
                  id='nombre',
                  name='nombre',
                  required,
                  value=formValues ? formValues.nombre : ''
                )

              .mb-3
                label.form-label(for='apellido') Apellido
                input.form-control(
                  type='text',
                  id='apellido',
                  name='apellido',
                  required,
                  value=formValues ? formValues.apellido : ''
                )

              .mb-3
                label.form-label(for='email') Email
                input.form-control(
                  type='email',
                  id='email',
                  name='email',
                  required,
                  value=formValues ? formValues.email : ''
                )

              .mb-3 
                label.form-label(for='telefono') telefono
                input.form-control(
                  type='text',
                  id='telefono',
                  name='telefono',
                  value=formValues ? formValues.telefono : ''

                )

              .mb-3 
                label.form-label(for='nacimiento')
                  Fecha de nacimiento 

                input.form-control(
                type='date',
                id='nacimiento',
                name='nacimiento',
                value=formValues ? formValues.nacimiento : ''

                )    



              .mb-3
                label.form-label(for='password') Contraseña
                input.form-control(
                type='password',
                id='password',
                name='password',
                required
                 )
              .mb-3
                label.form-label(for='confPassword') Confirmar contraseña
              
                input.form-control(
                  type='password',
                  id='confPassword',
                  name='confPassword',
                  required
                )

              button.btn.btn-primary.w-100.mb-3(type='submit')
                | Registrarse

              p.text-center
                | ¿Ya tenés cuenta?
                a.ms-1(href='/auth/login')
                  | Ingresá