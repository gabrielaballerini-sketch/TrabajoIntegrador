extends ../layoutPublico.pug
include ../mixins/alert

block metadata
  title Registrarse

block formulario
  
        .card.border-0.shadow.rounded-4(style="width:22rem; border-top: 4px solid #667eea !important;")
          .card-body(style="background:#fafafa; border-radius: 16px; padding: 2rem;")

            h3.card-title.text-center.mb-4(style="color:#667eea; font-weight:700;") Registrarse
            
            +alert(alert)
           
          
              



            form(method='POST', action='/auth/signup')

              .mb-3
                label.form-label(for='nombre') Nombre
                input.form-control.rounded-3(
                  type='text',
                  id='nombre',
                  name='nombre',
                  required,
                  value=formValues ? formValues.nombre : ''
                )

              .mb-3
                label.form-label(for='apellido') Apellido
                input.form-control.rounded-3(
                  type='text',
                  id='apellido',
                  name='apellido',
                  required,
                  value=formValues ? formValues.apellido : ''
                )

              .mb-3
                label.form-label(for='email') Email
                input.form-control.rounded-3(
                  type='email',
                  id='email',
                  name='email',
                  required,
                  value=formValues ? formValues.email : ''
                )

              .mb-3 
                label.form-label(for='telefono') telefono
                input.form-control.rounded-3(
                  type='text',
                  id='telefono',
                  name='telefono',
                  value=formValues ? formValues.telefono : ''

                )

              .mb-3 
                label.form-label(for='nacimiento')
                  Fecha de nacimiento 

                input.form-control.rounded-3(
                type='date',
                id='nacimiento',
                name='nacimiento',
                value=formValues ? formValues.nacimiento : ''

                )    



              .mb-3
                label.form-label(for='password') Contraseña
                input.form-control.rounded-3(
                type='password',
                id='password',
                name='password',
                required
                 )
              .mb-3
                label.form-label(for='confPassword') Confirmar contraseña
              
                input.form-control.rounded-3(
                  type='password',
                  id='confPassword',
                  name='confPassword',
                  required
                )

              button.btn.w-100.mb-3.rounded-3(
                        type='submit'
                        style="background:linear-gradient(135deg,#667eea,#764ba2); color:#fff; font-weight:600;"
                      ) Registrarse

              p.text-center.text-muted(style="font-size:14px;")
                       | ¿Ya tenés cuenta?
                       a.ms-1(href='/auth/login' style="color:#667eea; font-weight:600;") Ingresá