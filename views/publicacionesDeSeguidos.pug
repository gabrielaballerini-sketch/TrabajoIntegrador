extends layoutPrivado.pug
include mixins/publicacionMix.pug

block contenido
  .container.mt-4.p-4.rounded-4(style="background:#f5f5f5;")
    h1.mb-4.text-center(style="color:#667eea; letter-spacing:1px;") Novedades
    

  .row
      if !publicaciones || publicaciones.length === 0
        .col-12.text-center.py-5
          p.text-muted.fs-5 No hay publicaciones para mostrar.
          p.text-muted
            | Seguí a otros usuarios para ver su contenido acá.
          a.btn.btn-outline-primary(href='/home') Explorar publicaciones
      else
        each publicacion in publicaciones
          .col-12.mb-5(id=`pub-${publicacion.id}`)
            .mx-auto(style="max-width:700px;")
              +tarjetaPublicacion(publicacion, usuarioLogueado)

  script(src="/js/home.js")