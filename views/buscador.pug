extends layoutPrivado.pug
include mixins/publicacionMix.pug

block contenido
  .container.mt-4
    h1.mb-4.text-center Resultados de búsqueda

    if publicaciones.length === 0
      p.text-muted.text-center No se encontraron publicaciones

    else
      .row
        each publicacion in publicaciones
          .col-12.mb-5
            .mx-auto(style="max-width:700px;")
              +tarjetaPublicacion(publicacion, usuarioLogueado)