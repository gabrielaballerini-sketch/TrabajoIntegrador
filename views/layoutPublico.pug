extends layout.pug 
block content 
   
  .container-fluid
    .row.min-vh-100

      .col-md-6.d-flex.flex-column.justify-content-center.p-5.text-white(style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);")
        h1.display-3.fw-bold 📷 Fotaza
        p.lead.mt-3 Compartí tus fotos con el mundo
        hr.opacity-25
        p.opacity-75(style="font-size:15px;")
          | Subí tus mejores fotos, seguí a otros fotógrafos
          br
          | y descubrí imágenes increíbles de la comunidad.

      .col-md-6.d-flex.align-items-center.justify-content-center(style="background:#f5f5f5;")
        block formulario