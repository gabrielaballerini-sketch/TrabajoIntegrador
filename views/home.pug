extends layoutPrivado.pug 

block contenido
  .container.mt-4
    h1.mb-4 Home
    if !publicaciones || publicaciones.length === 0
      p.text-muted No hay publicaciones todavía
    else
      .row
      
        each publicacion in publicaciones
          .col-12.mb-5
            .mx-auto(style="max-width:700px;")

              .card.border-0
                .card-body

                  h4.fw-bold.text-dark.mb-1= publicacion.autor.nombre
                  h5.card-title.mb-2= publicacion.titulo
                  p.card-text.text-muted= publicacion.descripcion

                  if publicacion.imagenes && publicacion.imagenes.length > 0 
                    img.imagenPrincipal.rounded.mt-3.w-100(
                      src=publicacion.imagenes[0].src
                      style="max-height:500px; object-fit:cover;"
                    )

                  if publicacion.imagenes && publicacion.imagenes.length > 1
                    .d-flex.gap-2.mt-3.overflow-auto

                      each imagen in publicacion.imagenes
                        img.miniatura.rounded(

                          src=imagen.src
                          data-id=imagen.id
                          data-comentarios=JSON.stringify(imagen.comentarios ? imagen.comentarios.map(c => ({ nombre: c.usuario.nombre, contenido: c.contenido })) : [])
                          style="width:80px; height:80px; object-fit:cover; cursor:pointer;"
                        )

                  hr
                  h6 Comentarios
                  .comentariosContainer

                    if publicacion.imagenes && publicacion.imagenes.length > 0 && publicacion.imagenes[0].comentarios && publicacion.imagenes[0].comentarios.length > 0
                      each comentario in publicacion.imagenes[0].comentarios
                        .mb-2

                          strong= comentario.usuario.nombre + ': '
                          span= comentario.contenido
                    else
                      p.text-muted No hay comentarios todavía

                  form.formComentario(action=`/comentarios/${publicacion.imagenes && publicacion.imagenes.length > 0 ? publicacion.imagenes[0].id : ''}` method="POST")
                    .d-flex.gap-2.mt-3

                      input.form-control(

                        type="text"

                        name="contenido"

                        placeholder="Escribí un comentario"
                      )
                      button.btn.btn-dark(type="submit") Enviar

    script(src="/js/home.js")