extends layoutPrivado.pug
include mixins/publicacionMix.pug

block contenido
  .container.mt-4

    //- HEADER DEL PERFIL
    .mb-5.text-center
      h1.mb-4(style="color:#667eea;")= usuario.nombre + ' ' + usuario.apellido
      p.text-muted= usuario.email

      .d-flex.justify-content-center.gap-3.mb-3
        span.badge.bg-dark.p-2 Seguidores: #{cantidadSeguidores || 0}
        span.badge.bg-secondary.p-2 Siguiendo: #{cantidadSiguiendo || 0}

      if usuario.id != usuarioLogueado.id
        if siguiendo
          form(action=`/usuarios/${usuario.id}/dejar-seguir` method="POST")
            button.btn.btn-outline-dark(type="submit") Dejar de seguir
        else
          form(action=`/usuarios/${usuario.id}/seguir` method="POST")
            button.btn.btn-dark(type="submit") Seguir

    //- PUBLICACIONES
    h1.mb-4.text-center(style="color:#667eea; letter-spacing:1px;") Mis publicaciones

    .row
      if !publicaciones || publicaciones.length === 0
        p Todavía no hiciste publicaciones
      else
        each publicacion in publicaciones
          .col-12.mb-5
            .mx-auto(style="max-width:700px;")
              +tarjetaPublicacion(publicacion, usuarioLogueado)

  script(src="/js/home.js")