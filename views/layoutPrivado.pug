

extends ./layout.pug


block content


  nav.navbar.navbar-expand-lg.navbar-dark.bg-dark


    .container-fluid


      a.navbar-brand(href='/home') Fotaza

      button.navbar-toggler(
        type='button'
        data-bs-toggle='collapse'
        data-bs-target='#navbarNavAltMarkup'
        aria-controls='navbarNavAltMarkup'
        aria-expanded='false'
        aria-label='Toggle navigation'
      )

        span.navbar-toggler-icon

      #navbarNavAltMarkup.collapse.navbar-collapse

        .navbar-nav.me-auto
        

          a.nav-link(href='/home') Home
          a.nav-link(href='/perfil') Mi Perfil
          a.nav-link(href='/publicaciones/crear') Crear Publicación
          a.nav-link(href='href="/seguidores"') Seguidores: #{cantidadSeguidores}
          a.nav-link(href='href="/siguiendo') Siguiendo: #{cantidadSiguiendo}
          a.nav-link(href='#') Favoritos
          a.nav-link(href='#') Notificaciones

        form.d-flex.mx-auto.gap-2(
          action='/buscador'
          method='GET'
        )

          input.form-control(
            type='search'
            name='texto'
            placeholder='Buscar publicación'
          )



          input.form-control(
            type='search'
            name='usuario'
            placeholder='Buscar usuario'
          )



          input.form-control(
            type='search'
            name='etiqueta'
            placeholder='Buscar etiqueta'
          )




          button.btn.btn-outline-dark(type='submit')
            | Buscar

        .navbar-nav.ms-auto

          a.nav-link(href='/auth/logout')
            | Cerrar sesión

  block contenido