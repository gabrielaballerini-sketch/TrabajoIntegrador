extends ../layoutPrivado.pug



block contenido


  .container.mt-5(style="max-width:700px;")



    .card.shadow-sm.border-0



      .card-body.p-4


        h1.mb-4.text-center(style="color:#667eea; letter-spacing:1px;") Crear publicación

        form(action="/publicaciones/crear" method="post" enctype="multipart/form-data")

          .mb-4


            label.form-label(for="img") Imágenes


            input.form-control(
              type="file"
              name="imgs"
              id="img"
              multiple
            )

          #imgsPreview.row.g-3.mb-4

          #imgsBase64

          .mb-3

            label.form-label Título


            input.form-control(
              type="text"

              name="titulo"

              placeholder="Escribí un título"
            )

          .mb-4
          label.form-label(for="licencia") Tipo de Licencia
            select.form-select(name="licencia")
              option(value="sincopyright") 🔓 Pública
              option(value="copyright") 🔒 Privada
                     
            .form-text Elegí si otros pueden usar tu imagen o si prefieres protegerla.
                
          .mb-4

            label.form-label Descripción


            textarea.form-control(

              name="descripcion"

              rows="4"

              placeholder="Contá algo sobre tu publicación"

            )

            .mb-3

              label.form-label Etiquetas

              input.form-control(
              type="text"
              name="etiquetas"
              placeholder="playa verano mar"
              )
 



          button.btn.btn-dark.w-100(type="submit")

            | Publicar

          ul#errores.mt-3.text-danger


  script(src="/js/home.js")

